APP_NAME="PHP Boilerplate"
APP_ENV=development
APP_URL=http://127.0.0.1:8000

# Optional account and database features
AUTH_ENABLED=false
DB_DRIVER=none

# PostgreSQL/Supabase: used when AUTH_ENABLED=true and DB_DRIVER != none
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require
