APP_NAME="PHP Boilerplate"
APP_ENV=development
APP_URL=http://127.0.0.1:8000

# Copy the PostgreSQL connection details from Supabase Dashboard > Connect.
# For a pooled connection use the Supavisor host/port and username Supabase provides.
DB_HOST=your-project.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=replace-with-your-database-password
DB_SSLMODE=require
